# Copy to .env.local. With none of these set the app still runs: demo mode
# drives tool *choice*, and the in-repo seed drives the numbers.

# Neon Postgres (Vercel Marketplace → Neon). Without this, warehouse queries
# fall back to the same seed used by `npm run db:seed`. Shareable threads and
# durable rate limits need it in production.
DATABASE_URL=

# Option A — Vercel AI Gateway (recommended: one key, any provider, plus
# failover and cost tracking). https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Option B — Google AI Studio (Gemini). Either name works.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Option C — talk to OpenAI directly.
OPENAI_API_KEY=

# Which model drives the dashboard. Use a `provider/model` slug with the
# Gateway (e.g. anthropic/claude-sonnet-4.5). With a Google key, this defaults
# to google/gemini-2.5-flash if unset or still pointing at OpenAI.
CHAT_MODEL=google/gemini-3.6-flash
